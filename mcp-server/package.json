{
  "name": "browser-control-mcp",
  "version": "2.1.0",
  "description": "MCP server that gives Claude Code full control of your Chrome browser — navigate, click, fill forms, take screenshots, monitor network requests, manage cookies, and more",
  "type": "module",
  "main": "server.js",
  "bin": {
    "browser-control-mcp": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --import ./test/register-loader.mjs --test test/*.test.js",
    "test:coverage": "node --import ./test/register-loader.mjs --test --experimental-test-coverage test/*.test.js"
  },
  "keywords": [
    "mcp",
    "browser",
    "chrome",
    "automation",
    "claude",
    "claude-code",
    "model-context-protocol",
    "browser-control",
    "web-automation",
    "testing"
  ],
  "author": "Ross Kuehl <rosskuehl@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shoyu-ramen/browser-control-mcp.git"
  },
  "files": [
    "server.js",
    "lib/mcp.js",
    "lib/runtime.js",
    "tools/core.js",
    "tools/devtools.js",
    "tools/keyboard.js",
    "tools/dev.js",
    "tools/extended.js",
    "messaging/event-bus.js",
    "messaging/subscriptions.js",
    "messaging/session-state.js",
    "package.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "ws": "^8.18.0"
  }
}
