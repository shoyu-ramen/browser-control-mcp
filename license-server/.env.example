# Copy to .env and fill in. Never commit the real .env.
# Node >=20.6 can load it with:  node --env-file=.env server.js
# Otherwise export these in the shell / set them as Railway service variables.

# Port the service listens on.
PORT=8787

# Where the append-only event log + store-stats live (gitignored).
DATA_DIR=./data

# LemonSqueezy webhook signing secret (Settings → Webhooks → your endpoint).
# Required: without it, every webhook is rejected (fail-closed).
LEMONSQUEEZY_SIGNING_SECRET=

# LemonSqueezy API key — only needed later for order backfill via the LS API.
# The license activate/validate/deactivate proxy does NOT need it.
LEMONSQUEEZY_API_KEY=

# Bearer token guarding /metrics, /dashboard, /admin/*. Use a long random string.
# Required: without it, those routes are disabled (fail-closed).
ADMIN_TOKEN=

# Bounded offline grace for license clients, in hours (default 72): how long a
# validated entitlement may be trusted without revalidation before the client
# degrades to the free tier.
LICENSE_GRACE_HOURS=72
